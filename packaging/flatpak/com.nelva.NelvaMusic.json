{
    "app-id": "com.nelva.NelvaMusic",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.6",
    "sdk": "org.kde.Sdk",
    "command": "nelva",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--share=network",
        "--filesystem=home:ro",
        "--filesystem=xdg-config/aurora-music:create",
        "--filesystem=xdg-data/aurora-music:create",
        "--filesystem=xdg-music:ro",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.mpris.MediaPlayer2.Player",
        "--own-name=org.mpris.MediaPlayer2.NelvaMusic"
    ],
    "modules": [
        {
            "name": "python3-pyside6",
            "buildsystem": "simple",
            "build-options": {
                "build-args": ["--share=network"]
            },
            "build-commands": [
                "pip3 install --disable-pip-version-check --no-cache-dir --prefix=${FLATPAK_DEST} 'PySide6>=6.6.0'"
            ]
        },
        {
            "name": "python3-modules",
            "buildsystem": "simple",
            "build-options": {
                "build-args": ["--share=network"]
            },
            "build-commands": [
                "pip3 install --disable-pip-version-check --no-cache-dir --prefix=${FLATPAK_DEST} SQLAlchemy python-mpv watchdog mutagen librosa pillow numpy scipy soundfile"
            ]
        },
        {
            "name": "mpv",
            "buildsystem": "meson",
            "config-opts": [
                "-Dlibmpv=true",
                "-Dcplayer=false",
                "-Dlua=disabled",
                "-Dlibplacebo=disabled"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/mpv-player/mpv.git",
                    "tag": "v0.37.0"
                }
            ]
        },
        {
            "name": "nelvamusic",
            "buildsystem": "simple",
            "build-options": {
                "build-args": ["--share=network"]
            },
            "build-commands": [
                "pip3 install --no-build-isolation --prefix=${FLATPAK_DEST} .",
                "install -Dm644 packaging/nelvamusic.desktop ${FLATPAK_DEST}/share/applications/com.nelva.NelvaMusic.desktop",
                "install -Dm644 assets/icons/Nelva.png ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/nelva.png",
                "install -Dm644 packaging/flatpak/com.nelva.NelvaMusic.metainfo.xml ${FLATPAK_DEST}/share/metainfo/com.nelva.NelvaMusic.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
