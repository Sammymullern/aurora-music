#!/bin/bash
set -e

APPDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# libmpv is loaded by python-mpv through ctypes, so make its bundled path
# explicit in addition to the dynamic linker's search path.
export NELVA_LIBMPV="${APPDIR}/usr/lib/libmpv.so.2"
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/nelvamusic${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

exec "${APPDIR}/usr/lib/nelvamusic/NelvaMusic.bin" "$@"
